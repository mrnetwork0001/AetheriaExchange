# ── REQUIRED TO SHIP ────────────────────────────────────────────────────
# Deployer / venue-owner wallet private key (0x-prefixed). Signs deploys,
# seeding, and market resolution. NEVER commit the real .env file.
PRIVATE_KEY=

# ── AGENTS (optional, recommended) ──────────────────────────────────────
# Market-maker agent (scripts/market-maker.js). Use a DEDICATED low-balance
# wallet, never the deployer. Falls back to PRIVATE_KEY if unset.
MM_PRIVATE_KEY=
MM_BUDGET_OKB=3

# Frontend base URL the agents call for AI drafting and fair-odds
# (pulse-drafter.js, market-maker.js). Use the deployed URL in production.
AETHERIA_API_URL=http://localhost:3003

# Pulse Drafter topics (semicolon-separated; sensible defaults built in).
# DRAFTER_TOPICS=today's X Layer pulse market on daily active wallets

# Resolver: set to 1 to log settlement decisions without sending txs.
# RESOLVER_DRY_RUN=1
# Only markets created by these addresses auto-settle (default: the signer).
# RESOLVER_ALLOWED_CREATORS=0xdrafterWallet
# Skip markets that closed longer ago than this many seconds (default 7200).
# RESOLVER_MAX_STALENESS_SEC=7200

# ── OPTIONAL ────────────────────────────────────────────────────────────
# OKLink API key for contract verification on the X Layer explorer.
OKLINK_API_KEY=
