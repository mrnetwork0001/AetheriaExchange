# Deployer wallet private key (0x-prefixed). NEVER commit the real .env file.
PRIVATE_KEY=

# Optional: OKLink API key for contract verification on the X Layer explorer.
OKLINK_API_KEY=

# Market-maker agent (scripts/market-maker.js). Use a DEDICATED low-balance
# wallet, never the deployer. All knobs optional — see the script header.
MM_PRIVATE_KEY=
MM_BUDGET_OKB=3
