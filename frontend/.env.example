# ── AI ENGINE (pick ONE provider; the app runs in labeled offline mode
#    with neither) ─────────────────────────────────────────────────────────
# Provider selection: "anthropic" or "0g". Leave empty to auto-pick
# (Anthropic if its key is set, else 0G if its base URL is set).
AI_PROVIDER=

# Option A - Anthropic (schema-guaranteed structured outputs)
ANTHROPIC_API_KEY=

# Option B - 0G Compute (decentralized inference, OpenAI-compatible).
# From your 0G Compute dashboard: the inference endpoint base URL (paste it
# up to and including /v1 if shown), your API key/secret if the dashboard
# issues one, and the model name you have credits for.
ZG_COMPUTE_BASE_URL=
ZG_COMPUTE_API_KEY=
ZG_COMPUTE_MODEL=llama-3.3-70b-instruct

# ── 0G STORAGE (optional - decentralized co-pilot memory sync) ─────────
# A funded 0G-testnet wallet key; pays storage fees for encrypted memory
# blobs. Faucet: https://faucet.0g.ai. Without it, memory stays local-only.
ZG_STORAGE_PRIVATE_KEY=
# ZG_STORAGE_RPC=https://evmrpc-testnet.0g.ai
# ZG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai

# ── OKX DEX AGGREGATOR (in-app fallback routing; the grant-eligible path
#    is the OKX interface deep link and needs no keys) ────────────────────
# https://web3.okx.com/build/dev-portal
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_PROJECT_ID=

# ── AGENT OPS CONSOLE ───────────────────────────────────────────────────
# Shared secret the VPS agents must present when POSTing to /api/agent-log.
# Set the same value in contracts/.env. Unset = open posting (local dev only).
AGENT_LOG_SECRET=

# ── SHARED OPS FEED (Upstash Redis) ─────────────────────────────────────
# Required on any multi-instance host (Vercel): the AGENT OPS feed lives
# here so agents writing to one instance and visitors polling another see
# the same events. Without it the store is per-process - fine on a single
# always-on server, and the local dev default.
# Create a free database at https://console.upstash.com and copy the REST
# credentials (NOT the redis:// URL).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
